# Copy to .env and fill in. NEVER commit the real .env.

# ---- Run mode ----
# DRY_RUN  = monitor + simulate, place NO real orders (default, safe)
# LIVE_SMALL = real orders behind tight caps + kill switch
# LIVE      = real orders at full configured limits
BOT_RUN_MODE=DRY_RUN

# ---- Kalshi (https://kalshi.com) ----
KALSHI_API_KEY_ID=
KALSHI_API_PRIVATE_KEY_PATH=secrets/kalshi_private_key.pem
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_BASE=wss://api.elections.kalshi.com/trade-api/ws/v2
# Read request budget (req/min). Default 240 (4/s) is safely under Kalshi's basic ~10/s
# read tier. Raise toward your account's real limit for a faster watchlist refresh; lower
# it if you see HTTP 429s.
KALSHI_READ_RATE_PER_MIN=240

# ---- Polymarket US / QCEX ----
# Market data is PUBLIC (no key) on the gateway — the dry run needs no credentials.
QCEX_GATEWAY_BASE=https://gateway.polymarket.us
QCEX_API_BASE=https://api.polymarket.us
QCEX_WS_MARKETS=wss://api.polymarket.us/v1/ws/markets
QCEX_WS_PRIVATE=wss://api.polymarket.us/v1/ws/private
# Read request budget (req/min) for the public gateway. Default 300 (5/s); raise toward the
# gateway's real limit for a faster refresh, lower it on HTTP 429s.
QCEX_READ_RATE_PER_MIN=300
# Trading credentials (only needed to PLACE ORDERS, not for the dry run):
QCEX_API_KEY_ID=
# Provide EITHER the raw base64 secret string (preferred) OR a PEM file path:
QCEX_SECRET_KEY=
QCEX_ED25519_PRIVATE_KEY_PATH=secrets/qcex_ed25519.pem
QCEX_USE_SANDBOX=false

# ---- Local LLM (on-prem, OpenAI-compatible endpoint: vLLM or Ollama) ----
LLM_BASE_URL=http://localhost:8000/v1
LLM_REASONING_MODEL=qwen2.5-instruct
LLM_EMBEDDING_MODEL=nomic-embed-text

# ---- Risk limits ----
# Each arb is sized to the LARGEST whole-contract amount that fits ALL of: funded
# cash on each venue, top-of-book depth, the per-market cap, the total cap, and the
# per-order ceiling.
#
# Derive the exposure caps from the live balance check (sum of funded venue
# balances), refreshed each cycle — so cash is the real limit with no hardcoded
# dollars. When true, the RISK_MAX_POSITION_PER_MARKET / RISK_MAX_TOTAL_EXPOSURE
# values below are overridden.
RISK_CAPS_FROM_BALANCE=true
# Fallback exposure caps ($), used only when RISK_CAPS_FROM_BALANCE=false.
RISK_MAX_POSITION_PER_MARKET=300
RISK_MAX_TOTAL_EXPOSURE=300
# realized loss before the kill switch trips ($) — the backstop; keep it meaningful
RISK_MAX_DAILY_LOSS=50
# min per-contract edge ($) to act on an arb
RISK_MIN_EDGE=0.02
# per-order contract ceiling; 0 = NO ceiling (size up to balances + book depth)
RISK_MAX_ORDER_CONTRACTS=0
# Liquidity guard: min resting depth (contracts) required on BOTH legs before firing.
# Thin books are where one leg rejects and the other can't be hedged/unwound (a stuck
# naked position + halt). Skipping them means we should never have to unwind. The
# unwind also now crosses the real bid, but the guard avoids the situation entirely.
# 0 = off. A modest floor (e.g. 25) skips illiquid props while keeping real games.
EXEC_MIN_LEG_DEPTH=25
# Fraction of shown top-of-book depth to actually trade. Headroom so a fill-or-kill
# leg still fills if the book thins between the quote and the order (the cause of
# Kalshi "insufficient resting volume" rejections). 1.0 = use the full shown depth.
EXEC_DEPTH_FRACTION=0.85
# Skip a fire when either leg's ask is at a price extreme (<= this, or >= 1 - this).
# A binary at ~$0.01 is a settling/resolved market with phantom depth (no real resting
# volume), so its "edge" is an artifact (and the FOK rejects). 0 = disabled.
STREAM_MIN_LEG_PRICE=0.02
# How many of the best edges the periodic "edge snapshot" logs each refresh interval.
STREAM_EDGE_SNAPSHOT_TOP=5
# Require an edge to persist continuously this many seconds before acting. A cross-feed
# timing artifact (one venue's WS briefly leading the other) flickers and vanishes in
# ~100ms; a genuine venue-lag edge holds for seconds. This filters skew-phantoms at the
# trigger without a slow REST confirm. 0 = act on first sighting. Try ~0.75 for in-play.
STREAM_EDGE_PERSIST_SECS=0
# Streaming slow-loop cadence (s): how often the watchlist is rebuilt + re-primed. Lower =
# newly-listed markets picked up sooner, at the cost of more REST traffic. The prime is now
# concurrent (below), so lowering this is feasible. (--interval overrides it.)
STREAM_REFRESH_SECS=300
# Max concurrent REST snapshots when re-priming the watchlist each cycle (the rest are
# paced by the per-venue rate limiters). Higher = faster refresh (seconds vs >a minute).
STREAM_PRIME_CONCURRENCY=8
# Price cushion reserved for the hedge (second) leg so it fills through book movement
# WITHOUT unwinding. The bot only fires when the edge can pay this AND still lock
# RISK_MIN_EDGE — so thin edges that would just unwind never fire. Effective firing
# threshold = RISK_MIN_EDGE + this (e.g. 0.02 + 0.03 = 0.05). Bigger = fewer but safer
# fires. 0 = off (chase thin edges, accept unwinds). Ignored in maker mode.
EXEC_HEDGE_BUFFER=0.03
# Maker mode: capture THIN edges by RESTING the fee-heavy (Kalshi) leg as a maker (no
# slippage / lower fee), then TAKING the deep (Polymarket) leg the instant it fills.
# Fires at just RISK_MIN_EDGE (no hedge buffer). The maker self-expires if unfilled
# (clean no-trade). Best thin-edge economics; fills only when flow crosses your maker.
EXEC_MAKER_MODE=true
# How long (s) a resting maker waits to fill before it self-expires (no trade). Longer
# = more chances to get crossed (resting unfilled costs nothing; only the maker-fill ->
# hedge window is exposed). 20-30 is a reasonable soak value; 5 rarely gets hit.
EXEC_MAKER_TIMEOUT=20
# How far inside the ask to post the maker ($). Must be >= one tick (Kalshi = $0.01)
# so post-only doesn't reject it as crossing; also captures this much extra edge.
EXEC_MAKER_IMPROVEMENT=0.01
# Maker arming cushion ($/contract): a resting maker is exposed to the TAKER leg drifting
# against it before it fills (adverse selection — it tends to get crossed exactly when the
# market moves). Since the post-fill hedge is forced (you already hold the maker fill), a
# thin edge that drifts locks a GUARANTEED loss. Require this much edge ABOVE the lock
# floor before arming a maker — the maker analog of EXEC_HEDGE_BUFFER. Set at/above the
# typical taker drift over EXEC_MAKER_TIMEOUT. 0 disables it (unsafe: arms 1-2c edges that
# don't survive the rest window and lock losses). Raise if you see "FORCED-LOSS" warnings.
EXEC_MAKER_ARM_CUSHION=0.04
# While a maker rests, re-poll the taker leg every this-many seconds and CANCEL the maker
# if the taker drifts so the hedge can no longer lock the edge floor — so a resting maker
# never fills into an adverse move. This is the DYNAMIC guard (the cushion above is the
# static one at fire time); with it on you can safely lower EXEC_MAKER_ARM_CUSHION. Smaller
# = tighter (less fill-before-cancel race) but more REST polls per resting maker. 0 = off.
EXEC_MAKER_POLL=1.0
# Hybrid take-or-rest (maker mode only). Real, depth-backed edges on this venue pair are
# usually TAKER opportunities: they exist with real size RIGHT NOW (someone's resting the
# other side) but are efficiently priced enough that a maker would just sit uncrossed and
# miss them. When a depth-confirmed edge has >= this many contracts of real top-of-book
# size AND clears the taker bar (RISK_MIN_EDGE + EXEC_HEDGE_BUFFER), the bot crosses both
# books and LOCKS it immediately instead of resting a maker. Deep-but-thin edges (below
# the taker bar) and shallow edges still rest a maker as usual — best of both. Set this
# at/above EXEC_MIN_LEG_DEPTH (a take needs both legs to actually fill). 0 = disabled
# (pure maker mode, never auto-takes).
EXEC_HYBRID_TAKE_DEPTH=0
# Trust the WS live book and SKIP the per-fire REST depth re-fetch when both legs have
# a sized quote no older than this many seconds. Both venues now stream a sized
# top-of-book (Polymarket full book + Kalshi ticker sizes), so this removes the round
# trip from the hot path. 0 = always re-fetch (the old behavior).
STREAM_MAX_WS_QUOTE_AGE=2

# ---- Matching filter ----
# Gate the streaming watchlist with the structured fingerprint matcher instead of
# the series/title allowlists. Validated via `python -m bot.dryrun --compare-filters`
# (strict superset of the old filter: +real winners, -winner/method false positives).
MATCH_USE_FINGERPRINT=false
# Optional staged rollout: restrict to specific metrics (comma list, e.g.
# "winner" or "winner,goals,assists"). Empty = all matchable metrics.
MATCH_FINGERPRINT_METRICS=
# Per-cycle cross-venue discovery (embedding shortlist + LLM confirm). With the fingerprint
# sweep authoritative (MATCH_USE_FINGERPRINT=true) the watchlist is built straight from the
# scanned markets and match_verdicts is unused on the live path, so this pass is dead weight
# (~one embedding call per scanned title each cycle). false = skip it (much faster cycles,
# no embedding/LLM load); the scan still populates the markets table the sweep reads.
STREAM_DISCOVERY=false

# ---- Scan scope ----
# How far ahead (days) to scan markets by close time. 0 = NO window: scan every market
# regardless of when it closes (longer-dated futures, season props, championship markets).
# A positive value (e.g. 3-4) restricts to the imminent set to keep the scan small. Set 0
# to read/match ALL available markets. Kalshi uses server-side max_close_ts (client-side
# fail-safe); Polymarket filters client-side on endDate.
SCAN_CLOSE_WITHIN_DAYS=0
# Max markets pulled per venue per scan (TOTAL across paginated pages). 0 = the WHOLE board
# (paginate the entire feed; ~50k on Kalshi). Combined with SCAN_CLOSE_WITHIN_DAYS=0 this
# reads and matches everything. The tradeable set is still bounded by Polymarket's small
# universe, so this mainly controls how much of Kalshi is searched for a counterpart.
SCAN_LIMIT=0

# Fingerprint sweep recency (days): the matcher pairs every scanned market, so drop those
# whose EVENT date is more than this many days in the past. Settled games linger in the
# table (never pruned); this removes them using the fingerprint's parsed event date, so it
# works regardless of how often the streamer re-scans. 1 keeps today's + in-progress games.
# 0 = disabled (pair regardless of event date).
MATCH_SWEEP_PAST_DAYS=1

# ---- Startup reconciliation guard ----
# Before placing any order, the stream verifies every trading venue is funded and
# flat. Minimum balance required per venue ($); the stream aborts below this.
STARTUP_MIN_BALANCE=0
# Set true ONLY to allow running with pre-existing positions/resting orders.
# Default (false): refuse to trade if any venue is not flat on startup.
STARTUP_ALLOW_POSITIONS=false

# ---- Live execution ----
# The dry run is read-only. To place REAL orders, run with --live AND set the
# trading credentials above.
#   Kalshi HAS a demo (paper money) — validate here first:
#     KALSHI_API_BASE=https://demo-api.kalshi.co/trade-api/v2   (+ demo API key)
#   Polymarket US has NO sandbox/demo (prod-only, KYC). You can validate auth+reads
#     on prod for free; testing ORDER placement requires a tiny real-money trade.
