[Unit]
Description=Prediction-market arbitrage bot (STREAMING LIVE - REAL ORDERS)
After=network-online.target
Wants=network-online.target
# Limit restart bursts so a crash-loop can't hammer the exchanges.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
# Edit User and paths if your username/clone location differ.
User=keyahn
WorkingDirectory=/home/keyahn/Bot
# Log timestamps in local (Denver) time so they line up with the Kalshi/Polymarket apps.
# Only affects the process's local-time DISPLAY (Python's %(asctime)s); all internal time
# logic uses explicit UTC (datetime.now(timezone.utc)), so it is unaffected. Change the
# zone if you relocate; remove the line to log in the system timezone (UTC on this VM).
Environment=TZ=America/Denver
# Soft memory cap: above this the kernel reclaims this service's pages first (throttle,
# NOT an OOM-kill) so a full-board scan (SCAN_LIMIT=0) can't balloon RSS into swap and
# stall the event loop (a cause of WS keepalive timeouts). Raise it if the bot is slowed;
# it needs headroom under total RAM. MemoryMax is left unset so it is never killed mid-trade.
MemoryHigh=2G
# !!! REAL MONEY !!!
# --stream places REAL orders. Polymarket US has NO demo, so the Polymarket leg is
# ALWAYS real. For coherent cross-venue arb, BOTH venues must point at PRODUCTION in
# .env (Kalshi prod, NOT demo) — a demo Kalshi leg + real Polymarket leg leaves you
# holding a real naked position. The RISK_* caps in .env bound exposure.
# --limit is a TOTAL cap across paginated Kalshi pages (1000/page). 5000 reaches
# markets past the first page (e.g. UFC fights) so discovery can match them.
ExecStart=/home/keyahn/Bot/.venv/bin/python -m bot.dryrun --stream --limit 5000 --interval 300
# Restart only on crash (not clean exit). After ANY crash during live trading,
# MANUALLY verify open positions before re-enabling — the bot does not reconcile
# existing positions on startup, so an auto-restart could trade on top of them.
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arbbot-stream

[Install]
WantedBy=multi-user.target
